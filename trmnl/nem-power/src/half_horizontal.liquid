<div class="layout layout--col layout--center">
  {% if ok %}
    <span class="value value--xlarge value--tnums">{{ renewable_pct }}%</span>
    <span class="label">Renewables &middot; {{ total_gw }} GW generating</span>
  {% else %}
    <span class="value">No data</span>
    <span class="label">{{ error }}</span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">NEM Power</span>
  <span class="instance">{{ updated_at }}</span>
</div>

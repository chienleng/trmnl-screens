{% assign temp_id = 'wx-temp-' | append_random %}
{% assign rain_id = 'wx-rain-' | append_random %}

<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>

<style>
  /* Brutalist: pure black on white, heavy rules, no radii, no greys — greys
     dither into noise on a 1-bit panel and fall apart at viewing distance.
     Tufte: the charts carry no axes or gridlines; every number they'd encode
     is stated directly in the strap above them. */
  /* TRMNL's bundled bitmap faces. They carry no antialiasing, so nothing
     grey-fringes into dither noise — the crispest option on a 1-bit panel.
     Each is drawn for a native pixel size (12/16/21), so every font-size below
     is that native size or an exact integer multiple of it; off-multiple sizes
     interpolate and the stems go uneven. */
  .wx, .wx * {
    color: #000;
    font-family: 'TRMNL12', 'Courier New', monospace;
    font-weight: bold;
    -webkit-font-smoothing: none;
    font-smooth: never;
  }
  .wx { display: flex; flex-direction: column; height: 100%; overflow: hidden; }

  .wx-head {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase;
  }
  .wx-head-rule { border-bottom: 5px solid #000; margin-top: 5px; }

  .wx-now { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 8px; }
  /* 21 × 4 */
  .wx-temp { font-family: 'TRMNL21', monospace; font-size: 84px; line-height: 0.95; }
  /* 16 × 2 */
  .wx-cond { font-family: 'TRMNL16', monospace; font-size: 32px; line-height: 1; text-transform: uppercase; margin-top: 6px; }
  .wx-rain-block { text-align: right; }
  /* 21 × 3 */
  .wx-rain-val { font-family: 'TRMNL21', monospace; font-size: 63px; line-height: 0.95; }
  .wx-caption { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 8px; }

  .wx-strip { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 3px solid #000; margin-top: 10px; padding-top: 7px; }
  .wx-cell { border-left: 2px solid #000; padding-left: 12px; }
  .wx-cell:first-child { border-left: 0; padding-left: 0; }
  .wx-cell-label { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; }
  /* 16 × 2 */
  .wx-cell-value { font-family: 'TRMNL16', monospace; font-size: 32px; line-height: 1.1; }
  .wx-cell-unit { font-family: 'TRMNL12', monospace; font-size: 12px; }

  .wx-panel { margin-top: 8px; }
  .wx-panel-head {
    display: flex; justify-content: space-between; align-items: baseline;
    border-bottom: 2px solid #000; padding-bottom: 3px;
    font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .wx-panel-note { letter-spacing: 0.08em; }

  /* One time scale serving both panels — they share an x domain, so a second
     axis would be redundant ink. */
  .wx-scale {
    display: flex; justify-content: space-between; margin-top: 3px;
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
  }
</style>

<div class="wx">
  {% if ok %}
    <div class="wx-head">
      <span>{{ location }}</span>
      <span>{{ date_label }}</span>
    </div>
    <div class="wx-head-rule"></div>

    <div class="wx-now">
      <div>
        <div class="wx-temp">{{ temp }}&deg;</div>
        <div class="wx-cond">{{ conditions }}</div>
      </div>
      <div class="wx-rain-block">
        <div class="wx-rain-val">{{ rain_peak }}%</div>
        <div class="wx-caption">
          {% if rain_peak_at != '' %}Peak rain {{ rain_peak_at }}{% else %}No rain due{% endif %}
        </div>
      </div>
    </div>

    <div class="wx-strip">
      <div class="wx-cell">
        <div class="wx-cell-label">Feels</div>
        <div class="wx-cell-value">{{ feels_like }}&deg;</div>
      </div>
      <div class="wx-cell">
        <div class="wx-cell-label">Wind</div>
        <div class="wx-cell-value">{{ wind }}<span class="wx-cell-unit">km/h</span></div>
      </div>
      <div class="wx-cell">
        <div class="wx-cell-label">Humidity</div>
        <div class="wx-cell-value">{{ humidity }}%</div>
      </div>
      <div class="wx-cell">
        <div class="wx-cell-label">UV / Daylight</div>
        <div class="wx-cell-value">{{ uv_max }}<span class="wx-cell-unit">&nbsp;{{ sunrise }}&ndash;{{ sunset }}</span></div>
      </div>
    </div>

    <div class="wx-panel">
      <div class="wx-panel-head">
        <span>Temperature &mdash; next 24 h</span>
        <span class="wx-panel-note">{{ temp_min }}&deg; to {{ temp_max }}&deg;</span>
      </div>
      <div id="{{ temp_id }}"></div>
    </div>

    <div class="wx-panel">
      <div class="wx-panel-head">
        <span>Chance of rain &mdash; next 24 h</span>
        <span class="wx-panel-note">0&ndash;100%</span>
      </div>
      <div id="{{ rain_id }}"></div>
      <div class="wx-scale">
        <span>Now</span><span>+6 h</span><span>+12 h</span><span>+18 h</span><span>+24 h</span>
      </div>
    </div>
  {% else %}
    <div class="wx-head"><span>{{ location }}</span><span>Unavailable</span></div>
    <div class="wx-head-rule"></div>
    <div class="wx-cond" style="margin-top: 40px;">No data</div>
    <div class="wx-caption">{{ error }}</div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Weather</span>
  <span class="instance">{{ observed_at }} &middot; Open-Meteo</span>
</div>

{% if ok %}
<script>
  (function () {
    var TEMPS = {{ temps | json }};
    var RAIN = {{ rain | json }};
    var POINT_START = {{ point_start }};
    var POINT_INTERVAL = {{ point_interval }};
    var HOUR = 3600 * 1000;

    function whenReady(fn, tries) {
      if (window.Highcharts) return fn();
      if ((tries || 0) > 100) return;
      setTimeout(function () { whenReady(fn, (tries || 0) + 1); }, 100);
    }

    whenReady(function () {
      var px = function (v, el) { return window.TRMNLPaint ? TRMNLPaint.px(v, { el: el }) : v; };

      // Deliberately not TRMNLCharts.options(): each panel is a single black
      // series, so the dither ramp buys nothing and solid black stays crisp at
      // distance. Shared: no axes, no gridlines, no legend — pure data ink.
      function base(el, height) {
        return {
          chart: { animation: false, height: px(height, el), backgroundColor: 'transparent', margin: [6, 0, 0, 0], style: { fontFamily: 'Inter, sans-serif' } },
          title: { text: undefined },
          credits: { enabled: false },
          legend: { enabled: false },
          tooltip: { enabled: false },
          time: { useUTC: true }, // point_start is local wall-clock shifted to UTC
          xAxis: { type: 'datetime', visible: false, min: POINT_START, max: POINT_START + 23 * HOUR },
          yAxis: { visible: false, gridLineWidth: 0, endOnTick: false, startOnTick: false },
          // enableMouseTracking off is not about interactivity — it stops
          // Highcharts emitting its .highcharts-tracker-line, a fat
          // rgba(192,192,192,0.0001) path tracing the series. That is invisible
          // on screen and dithers away on 1-bit, but the X's 16-grey quantiser
          // rounds it up to the lightest grey step and it shows as smudges.
          plotOptions: { series: { enableMouseTracking: false, animation: false, pointStart: POINT_START, pointInterval: POINT_INTERVAL } }
        };
      }

      var tempEl = document.getElementById('{{ temp_id }}');
      var tempOpts = base(tempEl, 66);
      // Fill the panel: the range is stated in the strap above, so vertical
      // headroom here would just be dead ink.
      tempOpts.yAxis = { visible: false, gridLineWidth: 0, endOnTick: false, startOnTick: false, minPadding: 0.06, maxPadding: 0.06 };
      tempOpts.series = [{
        type: 'spline', data: TEMPS, color: '#000000',
        lineWidth: px(4, tempEl), marker: { enabled: false }
      }];
      Highcharts.chart(tempEl, tempOpts);

      var rainEl = document.getElementById('{{ rain_id }}');
      var rainOpts = base(rainEl, 56);
      // Pinned 0-100 so bar heights read as absolute probability rather than
      // rescaling to whatever the day's maximum happens to be.
      rainOpts.yAxis = { visible: false, gridLineWidth: 0, min: 0, max: 100, endOnTick: false, startOnTick: false };
      rainOpts.series = [{
        type: 'column', data: RAIN, color: '#000000',
        borderWidth: 0, groupPadding: 0, pointPadding: 0.08
      }];
      Highcharts.chart(rainEl, rainOpts);
    });
  })();
</script>
{% endif %}

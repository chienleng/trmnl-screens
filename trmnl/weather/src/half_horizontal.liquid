<style>
  /* Bitmap faces at their native pixel sizes or exact multiples — see
     full.liquid for why. */
  .wxh, .wxh * {
    color: #000;
    font-family: 'TRMNL12', 'Courier New', monospace;
    font-weight: bold;
    -webkit-font-smoothing: none;
    font-smooth: never;
  }
  .wxh { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
  .wxh-head { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; }
  .wxh-rule { border-bottom: 4px solid #000; margin-top: 4px; }
  .wxh-row { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 8px; }
  .wxh-temp { font-family: 'TRMNL21', monospace; font-size: 63px; line-height: 0.95; }
  .wxh-cond { font-family: 'TRMNL16', monospace; font-size: 16px; text-transform: uppercase; margin-top: 6px; }
  .wxh-rain { font-family: 'TRMNL21', monospace; font-size: 42px; line-height: 0.95; text-align: right; }
  .wxh-label { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 6px; text-align: right; }
</style>

<div class="wxh">
  {% if ok %}
    <div class="wxh-head">{{ location }}</div>
    <div class="wxh-rule"></div>
    <div class="wxh-row">
      <div>
        <div class="wxh-temp">{{ temp }}&deg;</div>
        <div class="wxh-cond">{{ conditions }}</div>
      </div>
      <div>
        <div class="wxh-rain">{{ rain_peak }}%</div>
        <div class="wxh-label">Peak rain</div>
      </div>
    </div>
  {% else %}
    <div class="wxh-head">{{ location }}</div>
    <div class="wxh-rule"></div>
    <div class="wxh-cond">No data</div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Weather</span>
  <span class="instance">{{ observed_at }}</span>
</div>

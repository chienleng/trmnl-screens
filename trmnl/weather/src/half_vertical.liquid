<style>
  /* Bitmap faces at their native pixel sizes or exact multiples — see
     full.liquid for why. */
  .wxv, .wxv * {
    color: #000;
    font-family: 'TRMNL12', 'Courier New', monospace;
    font-weight: bold;
    -webkit-font-smoothing: none;
    font-smooth: never;
  }
  .wxv { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
  .wxv-head { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; }
  .wxv-rule { border-bottom: 4px solid #000; margin-top: 4px; }
  .wxv-temp { font-family: 'TRMNL21', monospace; font-size: 63px; line-height: 0.95; margin-top: 12px; }
  .wxv-cond { font-family: 'TRMNL16', monospace; font-size: 16px; text-transform: uppercase; margin-top: 6px; }
  .wxv-cell { border-top: 2px solid #000; margin-top: 12px; padding-top: 6px; }
  .wxv-label { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; }
  .wxv-value { font-family: 'TRMNL16', monospace; font-size: 32px; line-height: 1.1; }
</style>

<div class="wxv">
  {% if ok %}
    <div class="wxv-head">{{ location }}</div>
    <div class="wxv-rule"></div>
    <div class="wxv-temp">{{ temp }}&deg;</div>
    <div class="wxv-cond">{{ conditions }}</div>
    <div class="wxv-cell">
      <div class="wxv-label">Feels like</div>
      <div class="wxv-value">{{ feels_like }}&deg;</div>
    </div>
    <div class="wxv-cell">
      <div class="wxv-label">Peak rain</div>
      <div class="wxv-value">{{ rain_peak }}%</div>
    </div>
  {% else %}
    <div class="wxv-head">{{ location }}</div>
    <div class="wxv-rule"></div>
    <div class="wxv-cond">No data</div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Weather</span>
  <span class="instance">{{ observed_at }}</span>
</div>

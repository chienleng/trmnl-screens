<style>
  /* Bitmap faces at their native pixel sizes or exact multiples — see
     full.liquid for why. */
  .wxq, .wxq * {
    color: #000;
    font-family: 'TRMNL12', 'Courier New', monospace;
    font-weight: bold;
    -webkit-font-smoothing: none;
    font-smooth: never;
  }
  .wxq { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
  .wxq-head { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; }
  .wxq-rule { border-bottom: 3px solid #000; margin-top: 4px; }
  .wxq-temp { font-family: 'TRMNL21', monospace; font-size: 63px; line-height: 0.95; margin-top: 8px; }
  .wxq-cond { font-family: 'TRMNL16', monospace; font-size: 16px; text-transform: uppercase; margin-top: 6px; }
  .wxq-rain { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 8px; }
</style>

<div class="wxq">
  {% if ok %}
    <div class="wxq-head">{{ location }}</div>
    <div class="wxq-rule"></div>
    <div class="wxq-temp">{{ temp }}&deg;</div>
    <div class="wxq-cond">{{ conditions }}</div>
    <div class="wxq-rain">Rain to {{ rain_peak }}%</div>
  {% else %}
    <div class="wxq-head">{{ location }}</div>
    <div class="wxq-rule"></div>
    <div class="wxq-cond">No data</div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Weather</span>
</div>

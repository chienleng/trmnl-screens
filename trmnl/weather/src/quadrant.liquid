<style>
  .wxq, .wxq * {
    color: #000;
    font-family: Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .wxq { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
  .wxq-head { font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }
  .wxq-rule { border-bottom: 3px solid #000; margin-top: 3px; }
  .wxq-temp { font-size: 62px; font-weight: 800; line-height: 0.85; letter-spacing: -0.04em; margin-top: 8px; }
  .wxq-cond { font-size: 15px; font-weight: 800; text-transform: uppercase; margin-top: 4px; }
  .wxq-rain { font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; margin-top: 6px; }
</style>

<div class="wxq">
  {% if ok %}
    <div class="wxq-head">{{ location }}</div>
    <div class="wxq-rule"></div>
    <div class="wxq-temp">{{ temp }}&deg;</div>
    <div class="wxq-cond">{{ conditions }}</div>
    <div class="wxq-rain">Rain to {{ rain_peak }}%</div>
  {% else %}
    <div class="wxq-head">{{ location }}</div>
    <div class="wxq-rule"></div>
    <div class="wxq-cond">No data</div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Weather</span>
</div>
